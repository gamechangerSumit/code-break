# Server
SERVER_PORT=8088

# PostgreSQL (keep POSTGRES_PASSWORD and DATABASE_PASSWORD in sync)
DATABASE_URL=jdbc:postgresql://localhost:5432/codebreak
DATABASE_USERNAME=codebreak
DATABASE_PASSWORD=replace-with-the-same-strong-password-as-POSTGRES_PASSWORD
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Redis (localhost-only Docker Compose service)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3-compatible storage (keep app credentials in sync with root credentials below)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace-with-the-same-value-as-MINIO_ROOT_USER
MINIO_SECRET_KEY=replace-with-the-same-value-as-MINIO_ROOT_PASSWORD
MINIO_BUCKET=codebreak

# REQUIRED: replace with a cryptographically random secret containing at least 32 bytes.
JWT_SECRET=replace-with-at-least-32-random-bytes-before-starting-the-backend

# Browser origins; use your actual frontend origin in non-local environments.
CORS_ALLOWED_ORIGINS=http://localhost:5173
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

# Docker Compose database credentials
POSTGRES_DB=codebreak
POSTGRES_USER=codebreak
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Docker Compose MinIO root credentials
MINIO_ROOT_USER=replace-with-a-minio-username
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
