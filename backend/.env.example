# Server
SERVER_PORT=8088

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/codebreak
DATABASE_USERNAME=codebreak
DATABASE_PASSWORD=change-me
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3-compatible storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=codebreak

# REQUIRED: generate a cryptographically random secret of at least 32 bytes.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

# Docker Compose database credentials
POSTGRES_DB=codebreak
POSTGRES_USER=codebreak
POSTGRES_PASSWORD=change-me

# Docker Compose MinIO root credentials
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-long-secret
