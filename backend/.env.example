# Copy to backend/.env on the EC2 host. Replace DOMAIN and generate unique secrets.
DOMAIN=localhost
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
RUSTFS_ACCESS_KEY=replace-with-a-unique-storage-access-key
RUSTFS_SECRET_KEY=replace-with-a-long-random-storage-secret
APP_CORS_ALLOWED_ORIGINS=http://localhost

# Optional AI assistant. Leave AI_API_KEY empty to disable AI.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4.1-mini

# Optional private Judge0-compatible runner; never expose it directly to the public internet.
CODE_RUNNER_URL=
CODE_RUNNER_API_KEY=

# Optional GitHub token encryption key: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=
